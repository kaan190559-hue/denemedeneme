# Hetzner production — kopyala: cp .env.production.example .env
# Gizli değerleri repoya yazma.

POSTGRES_PASSWORD=DEGISTIR_uzun_rastgele_sifre

# Domain kurulunca: https://bozok.senindomain.com
BOZOK_PUBLIC_URL=https://bozok.bozokfinans.uk

TELEGRAM_BOT_TOKEN=
TELEGRAM_USE_POLLING=0
# Opsiyonel: bot SS komutlari icin. Bos birakilirsa bot token kullanilir.
TELEGRAM_CAPTURE_TOKEN=

MOON_AUTOMATION_ENABLED=0
MOON_USERNAME=
MOON_PASSWORD=
MOON_TOTP_SECRET=
MOON_AUTOMATION_INTERVAL_MS=3000
MOON_HEADLESS=1
MOON_CACHE_DATABASE=1

BOZOK_SECURITY_ENABLED=0
EXCEL_CENTER_ENABLED=0
ONEDRIVE_CENTER_ENABLED=0
